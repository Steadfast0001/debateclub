# ============================================================================
# BIAKA DEBATE CLUB - ENVIRONMENT VARIABLES
# Copy this file to .env and fill in all values with your own credentials
# ============================================================================

# DATABASE CONFIGURATION
# PostgreSQL connection string. Get this from Neon.tech or Supabase
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://user:password@localhost:5432/biaka_debate

# JWT AUTHENTICATION
# Random secret key for token signing - generate a long random string
# You can generate one at: https://www.random.org/bytes/ or use `openssl rand -hex 32`
JWT_SECRET=your_super_secret_jwt_key_change_this

# EMAIL CONFIGURATION (Gmail SMTP)
# The email address from which to send notifications
GMAIL_USER=biakadebateclub@gmail.com

# Gmail app-specific password (NOT your regular Gmail password!)
# Steps to generate:
# 1. Enable 2FA on your Google account at https://myaccount.google.com/security
# 2. Go to https://myaccount.google.com/apppasswords
# 3. Select "Mail" and "Windows Computer"
# 4. Google will generate a 16-character app-specific password
# 5. Paste it below (without spaces)
GMAIL_APP_PASSWORD=your_app_specific_password_here

# ADMIN CONFIGURATION
# Email where registration notifications are sent
ADMIN_EMAIL=biakadebateclub@gmail.com

# Admin API key for protecting endpoints - change this to a random string!
# Used in X-Admin-Key header for admin endpoints
# Generate with: openssl rand -hex 16
ADMIN_KEY=your_admin_api_key_change_this

# SITE CONFIGURATION
# Full URL where your site is hosted (for email links and redirects)
# Local development: http://localhost:3000
# Vercel: https://your-project.vercel.app
# Netlify: https://your-site.netlify.app
SITE_URL=http://localhost:3000

# Node environment
# Use "development" locally, "production" on Vercel/Netlify
NODE_ENV=development

# PORT (optional)
# Server port - defaults to 3000
# PORT=3000
